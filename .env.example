KTOR_PORT=8080

QUINBOOK_CLIENT_ID=
QUINBOOK_CLIENT_SECRET=
QUINBOOK_BASE_URL=https://api2.quinbook.com

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=escape-house
MONGO_APP_PASSWORD=
