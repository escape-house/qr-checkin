# When run locally
MONGODB_CONNECTION_STRING=mongodb://escape-house:CHANGE_MONGO_APP_PW@localhost:27017/escape-house?authSource=escape-house
MONGODB_DATABASE=escape-house

# Comma-separated room names (lowercase) controlling column order in the admin timetable.
# Falls back to the hardcoded default order if unset.
VITE_ROOM_ORDER=unfinished,villa des wahnsinns,die zauberhafte winkelgasse,western bank,jack the ripper,saw